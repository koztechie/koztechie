<!DOCTYPE html>
<html lang="{{ lang | default('en') }}" dir="ltr">
<head>
  {% include "layouts/head.njk" %}
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <!-- SVG noise texture filter — injected into DOM, referenced by CSS -->
  <svg class="noise-layer" width="100%" height="100%" aria-hidden="true" focusable="false">
    <filter id="noise-filter">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.72"
        numOctaves="4"
        stitchTiles="stitch"
      />
      <feColorMatrix type="saturate" values="0"/>
    </filter>
    <rect width="100%" height="100%" filter="url(#noise-filter)"/>
  </svg>

  <!-- Decorative glow strips -->
  <div class="glow-strip glow-strip--left" aria-hidden="true"></div>
  <div class="glow-strip glow-strip--right" aria-hidden="true"></div>

  <div class="site-wrapper">
    <main class="main-grid" id="main-content" role="main">
      {% set t = translations[lang] %}

      <div class="block--name" data-reveal="0">
        {% include "components/identity.njk" %}
      </div>

      <div class="block--manifesto" data-reveal="1">
        {% include "components/manifesto.njk" %}
      </div>

      <div class="block--social" data-reveal="2">
        {% include "components/social.njk" %}
      </div>

      <div class="block--lang" data-reveal="3">
        {% include "components/lang-switcher.njk" %}
      </div>

    </main>

    <footer class="site-footer" role="contentinfo">
      {% set t = translations[lang] %}
      <span class="t-label">© {{ "now" | date("yyyy") }} Eugene Kozlovsky</span>
      <span class="t-label">{{ t.built_with | default('built with 11ty') }}</span>
    </footer>
  </div>

  <!-- Scripts -->
  <script src="/assets/js/glitch.js" defer></script>
  <script src="/assets/js/cursor.js" defer></script>
  <script src="/assets/js/lang-switcher.js" defer></script>

</body>
</html>
