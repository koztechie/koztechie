<div class="identity">
  <h2 class="t-label identity__prefix" aria-hidden="true">// {{ t.init_label | default('init') }}</h2>

  <h1 class="t-name identity__name" id="site-name" aria-label="Eugene Kozlovsky">
    <span class="glitch-target" data-text="Eugene">Eugene</span>
    <br>
    <span class="name-second-line">
      <span class="glitch-target" data-text="Kozlovsky">Kozlovsky</span><span class="cursor-blink" aria-hidden="true">_</span>
    </span>
  </h1>

  <div class="accent-rule" aria-hidden="true"></div>

  <p class="t-identity identity__line">
    {{ t.identity_line | default('Prompt Engineer × Systems Thinker') }}
  </p>
</div>
