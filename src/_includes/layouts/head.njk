<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">

<title>{% if title %}{{ title }} — koztechie{% else %}koztechie — Eugene Kozlovsky{% endif %}</title>
<meta name="description" content="{{ description | default('Eugene Kozlovsky — Prompt Engineer × Systems Thinker. Building with AI at the edge of what\'s possible.') }}">
<meta name="author" content="Eugene Kozlovsky">
<meta name="theme-color" content="#08090d">
<meta name="color-scheme" content="dark">

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:url" content="https://koztechie.pp.ua{{ page.url }}">
<meta property="og:title" content="{% if title %}{{ title }} — koztechie{% else %}koztechie{% endif %}">
