<div class="identity">
  <span class="t-label identity__prefix" aria-hidden="true">// {{ t.init_label | default('init') }}</span>

  <h1 class="t-name identity__name" id="site-name">
    <span class="glitch-target" data-text="{{ t.first_name | default('Eugene') }}">{{ t.first_name | default('Eugene') }}</span>
    <br>
    <span class="name-second-line">
      <span class="glitch-target" data-text="{{ t.last_name | default('Kozlovsky') }}">{{ t.last_name | default('Kozlovsky') }}</span><span class="cursor-blink" aria-hidden="true">_</span>
    </span>
    <span class="sr-only"> — {{ t.title | replace(t.first_name + " " + t.last_name + " | ", "") | replace(t.first_name + " " + t.last_name + " y ", "") | replace(t.first_name + " " + t.last_name + " та ", "") }}</span>
  </h1>

  <div class="accent-rule" aria-hidden="true"></div>

  <p class="t-identity identity__line">
    {{ t.identity_line | default('Prompt Engineer × Systems Thinker') }}
  </p>
</div>
