<meta property="og:image" content="https://koztechie.pp.ua/assets/img/og-cover.jpg">
<meta property="og:locale" content="{{ locale | default('en_US') }}">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@koztechie">
<meta name="twitter:creator" content="@koztechie">
<meta name="twitter:title" content="koztechie — Eugene Kozlovsky">
<meta name="twitter:description" content="Prompt Engineer × Systems Thinker.">
<meta name="twitter:image" content="https://koztechie.pp.ua/assets/img/og-cover.jpg">

<!-- Canonical -->
<link rel="canonical" href="https://koztechie.pp.ua{{ page.url }}">

<!-- Alternate language versions -->
